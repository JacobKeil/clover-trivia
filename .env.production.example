# Used by `docker compose --env-file .env.production -f docker-compose.production.yml …`
APP_IMAGE=your-dockerhub-user/clover-trivia:latest
POSTGRES_DB=clover_trivia
POSTGRES_USER=clover
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://clover:replace-with-a-long-random-password@db:5432/clover_trivia

DOMAIN=trivia.example.com
CERTBOT_EMAIL=admin@example.com
ORIGIN=https://trivia.example.com
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_S3_BUCKET_NAME=
AMS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
